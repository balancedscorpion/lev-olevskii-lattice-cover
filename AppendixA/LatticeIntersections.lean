module

public import AppendixA.Definitions
public import Mathlib.Algebra.Module.ZLattice.Basic
public import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional

/-!
# Intersections of full-rank lattice translates

A nonempty intersection is one coset of the intersection of its underlying
integer lattices. Its real span gives either a full-rank lattice basis or
a nonzero normal to a containing affine hyperplane.
-/

@[expose] public section

namespace MeyerGeneralProblem.LevOlevskii

noncomputable section

open Set Module Matrix
open scoped Matrix RealInnerProductSpace

/-- The additive lattice generated by the matrix columns. -/
def matrixLattice {d : ℕ} (T : Matrix (Fin d) (Fin d) ℝ) : Submodule ℤ (Space d) :=
  Submodule.span ℤ (range fun i => WithLp.toLp 2 (T.col i))

private theorem latticeSite_sum {d : ℕ} (t : Space d) (T : Matrix (Fin d) (Fin d) ℝ)
    (z : Fin d → ℤ) : latticeSite t T z = t + ∑ i, z i • WithLp.toLp 2 (T.col i) := by
  ext k
  simp [latticeSite, Matrix.mulVec, dotProduct, Matrix.col, Finset.sum_apply, mul_comm]

theorem mem_latticeCoset_iff {d : ℕ} (t x : Space d) (T : Matrix (Fin d) (Fin d) ℝ) :
    x ∈ range (latticeSite t T) ↔ x - t ∈ matrixLattice T := by
  rw [matrixLattice, Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨z, rfl⟩
    exact ⟨z, by rw [latticeSite_sum, add_sub_cancel_left]⟩
  · rintro ⟨z, hz⟩
    exact ⟨z, by rw [latticeSite_sum, hz, add_sub_cancel]⟩

theorem matrixLattice_discrete {d : ℕ} (T : Matrix (Fin d) (Fin d) ℝ) (hT : T.det ≠ 0) :
    DiscreteTopology (matrixLattice T) := by
  let f (i : Fin d) : Space d := WithLp.toLp 2 (T.col i)
  have hli : LinearIndependent ℝ f :=
    ((WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).symm.toLinearMap.linearIndependent_iff (by simp)).mpr
      (Matrix.linearIndependent_cols_iff_isUnit.mpr (T.isUnit_iff_isUnit_det.mpr (isUnit_iff_ne_zero.mpr hT)))
  let b := basisOfLinearIndependentOfCardEqFinrank' f hli (by simp)
  have hb : ⇑b = f := Basis.coe_mk ..
  change DiscreteTopology (Submodule.span ℤ (range f))
  rw [← hb]
  infer_instance

private theorem discrete_lattice_matrix {d : ℕ} (L : Submodule ℤ (Space d)) [DiscreteTopology L]
    (hspan : Submodule.span ℝ (L : Set (Space d)) = ⊤) :
    ∃ T : Matrix (Fin d) (Fin d) ℝ, T.det ≠ 0 ∧ matrixLattice T = L := by
  let : IsZLattice ℝ L := ⟨hspan⟩
  let := ZLattice.module_free ℝ L
  let b := Module.Free.chooseBasis ℤ L
  let R := b.ofZLatticeBasis ℝ L
  let e := R.indexEquiv (EuclideanSpace.basisFun (Fin d) ℝ).toBasis
  let v := b.reindex e
  let T : Matrix (Fin d) (Fin d) ℝ := fun i j => (v j).val i
  have heq (i : Fin d) : WithLp.toLp 2 (T.col i) = (v i).val := rfl
  have hcol : LinearIndependent ℝ T.col := by
    apply ((WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).symm.toLinearMap.linearIndependent_iff (by simp)).mp
    convert (v.ofZLatticeBasis ℝ L).linearIndependent using 1
    funext j
    rw [Basis.ofZLatticeBasis_apply]
    exact heq j
  refine ⟨T, (T.isUnit_iff_isUnit_det.mp (Matrix.linearIndependent_cols_iff_isUnit.mp hcol)).ne_zero, ?_⟩
  simp only [matrixLattice, heq]
  change Submodule.span ℤ (range (L.subtype ∘ v)) = L
  rw [range_comp, ← Submodule.map_span, v.span_eq, Submodule.map_top, Submodule.range_subtype]

/-- Every inhabited intersection from a nonempty family is exactly a
full-rank lattice translate or lies in an affine hyperplane. -/
theorem latticeIntersection_lattice_or_hyperplane {d : ℕ} {ι : Type*} [Nonempty ι]
    (t : ι → Space d) (T : ι → Matrix (Fin d) (Fin d) ℝ) (hT : ∀ j, (T j).det ≠ 0)
    (p : Space d) (hp : ∀ j, p ∈ range (latticeSite (t j) (T j))) :
    (∃ U : Matrix (Fin d) (Fin d) ℝ, U.det ≠ 0 ∧
      (⋂ j, range (latticeSite (t j) (T j))) = range (latticeSite p U)) ∨
    (∃ v : Space d, v ≠ 0 ∧ ∀ y ∈ ⋂ j, range (latticeSite (t j) (T j)),
      inner ℝ v y = inner ℝ v p) := by
  let L := ⨅ j, matrixLattice (T j)
  have hmem (y : Space d) : y ∈ ⋂ j, range (latticeSite (t j) (T j)) ↔ y - p ∈ L := by
    simp only [mem_iInter, L, Submodule.mem_iInf, mem_latticeCoset_iff]
    constructor
    · intro hy j
      have h := (matrixLattice (T j)).sub_mem (hy j) ((mem_latticeCoset_iff ..).mp (hp j))
      simpa only [sub_sub_sub_cancel_right] using h
    · intro hy j
      have h := (matrixLattice (T j)).add_mem (hy j) ((mem_latticeCoset_iff ..).mp (hp j))
      simpa only [sub_add_sub_cancel] using h
  let W := Submodule.span ℝ (L : Set (Space d))
  by_cases hspan : W = ⊤
  · obtain ⟨j⟩ := ‹Nonempty ι›
    have hd : IsDiscrete (matrixLattice (T j) : Set (Space d)) :=
      isDiscrete_iff_discreteTopology.mpr (matrixLattice_discrete _ (hT j))
    let : DiscreteTopology L := isDiscrete_iff_discreteTopology.mp (hd.mono
      (show (L : Set (Space d)) ⊆ matrixLattice (T j) from SetLike.coe_subset_coe.mpr (iInf_le (fun k => matrixLattice (T k)) j)))
    obtain ⟨U, hU, heq⟩ := discrete_lattice_matrix L hspan
    exact Or.inl ⟨U, hU, Set.ext fun y => by rw [hmem, mem_latticeCoset_iff, heq]⟩
  · have horth : Wᗮ ≠ ⊥ := fun h => hspan (W.orthogonal_eq_bot_iff.mp h)
    obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot horth
    refine Or.inr ⟨v, hv0, fun y hy => ?_⟩
    have hdiff : y - p ∈ W := Submodule.subset_span ((hmem y).mp hy)
    have heq := Submodule.inner_left_of_mem_orthogonal hdiff hv
    rw [inner_sub_right, sub_eq_zero] at heq
    exact heq

end
end MeyerGeneralProblem.LevOlevskii
